{
  "name": "seedgrid",
  "version": "1.0.0",
  "description": "Minecraft seed map viewer",
  "main": "main.js",
  "author": "Exempler201",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nullforge.seedgrid",
    "productName": "SeedGrid",
    "artifactName": "SeedGrid-${version}-win.exe",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "game-bridge.js",
      "package.json",
      "cubiomes.js",
      "cubiomes.wasm",
      "engine/**",
      "renderer/**",
      "assets/**",
      "!assets/icon-256.png"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    }
  }
}
